API_KEY=
BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat
ENABLE_LLM_RESPONSE=false
FRONTEND_PORT=3001
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
POSTGRES_PASSWORD=customer_service_dev
POSTGRES_PORT=15433
# JSON object mapping opaque tokens to server-controlled staff identities.
STAFF_API_KEYS={"replace-with-long-random-token":{"staff_id":"agent_001","roles":["reviewer"]}}
# Local Python development (Docker Compose overrides this with host `postgres`):
# DATABASE_URL=postgresql://customer_service:customer_service_dev@localhost:15433/customer_service

# 会话令牌与证据图片链接的签名密钥（生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"）。
# 不设置时每次后端重启都会生成新密钥，所有人需要重新登录。
AUTH_SECRET=
# 演示登录（选择 Mock 账号即可登录，无需密码）。docker-compose 默认开启；生产环境应关闭并接入真实身份系统。
DEMO_LOGIN_ENABLED=true
